---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/LZWcc'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='programs'>Programs</h2>
  {/* 每个项目的第一个链接是作品站（lab.lzwcc.xyz）上的项目页，详细介绍和截图在那边 */}
  <ProjectSection
    projects={[
      {
        name: 'ui-motion-lab',
        description: '作品站：网上看到的界面和动效重写成可交互的演示，附提示词。',
        links: [{ type: 'site', href: 'https://lab.lzwcc.xyz/' }]
      },
      {
        name: 'MaintPilot',
        image: 'maintpilot.webp',
        description: '设备检修 AI 诊断系统。两人合作，我负责前端和部署。',
        links: [
          { type: 'doc', href: 'https://lab.lzwcc.xyz/project/maintpilot' },
          { type: 'site', href: 'https://maintpilot.lzwcc.xyz/welcome' }
        ]
      },
      {
        name: 'Niwa',
        image: 'niwa.webp',
        description: '浏览器新标签页扩展，已上架 Edge 扩展商店。',
        links: [
          { type: 'doc', href: 'https://lab.lzwcc.xyz/project/niwa' },
          {
            type: 'site',
            href: 'https://microsoftedge.microsoft.com/addons/detail/niwa/aonnmkpdcdkcfhcionbpmigmfbjcmnec'
          },
          { type: 'github', href: 'https://github.com/LZWcc/Niwa' }
        ]
      },
      {
        name: 'token-stats',
        image: 'token-stats.webp',
        description: '汇总几台机器的 AI 编程 token 用量，画成主页卡片。',
        links: [
          { type: 'doc', href: 'https://lab.lzwcc.xyz/project/token-stats' },
          { type: 'github', href: 'https://github.com/LZWcc/token-stats' }
        ]
      },
      {
        name: 'CareerskyHelper',
        description: '北森生涯教育平台(章节视频自动切换 + 防止切换界面自动暂停)',
        links: [{ type: 'github', href: 'https://github.com/LZWcc/CareerskyHelper' }]
      }
    ]}
  />

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'CS61A - sp25',
        description: 'Structure and Interpretation of Computer Programs',
        links: [
          {
            type: 'github',
            href: 'https://github.com/LZWcc/CS61A'
          }
        ]
      },
      {
        name: 'CS61B - sp25',
        description: 'Data Structures and Algorithms',
        links: [
          {
            type: 'github',
            href: 'https://github.com/LZWcc/cs61b-sp25'
          }
        ]
      }
    ]}
  />
</PageLayout>
