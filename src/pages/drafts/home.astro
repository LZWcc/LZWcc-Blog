---
// 首页草稿（homepage-feed 分支）：照 ui-motion-lab 标签 homepage-feed-v1 的信息流三栏版。
//   左边个人资料（颗粒渐变横幅），中间每篇文章是一条动态（置顶一段自我介绍，可以按类别筛选），
//   右边写作记录、作品站最新作品、常用的工具、AI 用量、GitHub。
// 配色用作品站的 --h-* 变量（只在这一页），顶栏也是这一页自己的；页脚用博客主题的。
// 作品站的数据来自 lab.lzwcc.xyz/home.json（src/utils/home-data.ts）。定下来以后替换 src/pages/index.astro。
import { Image } from 'astro:assets'
import { render } from 'astro:content'

import { Footer, ThemeProvider } from 'astro-pure/components/basic'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Icon } from 'astro-pure/user'
import BaseHead from '@/components/BaseHead.astro'
import Heatmap from '@/components/feed/Heatmap.astro'
import TechStack from '@/components/feed/TechStack.astro'
import TokenUsage from '@/components/feed/TokenUsage.astro'
import { authorshipLabel } from '@/utils/authorship'
import { writingDays } from '@/utils/heatmap'
import { getHomeData, LAB } from '@/utils/home-data'
import banner from '@/assets/home/banner.webp'
import config from '@/site-config'

import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

const posts = sortMDByDate(await getBlogCollection())
const tags = getUniqueTagsWithCount(posts)
const home = await getHomeData()

// 中间一栏的筛选：一篇只归一类
const AI_TAGS = ['claude', 'claude code', 'codex', 'ai', 'skill']
const STUDY_BEFORE = new Date('2026-06-01')
type Tab = 'all' | 'ai' | 'eng' | 'study'
const TAB_NAME: Record<Exclude<Tab, 'all'>, string> = {
  ai: 'AI 协作',
  eng: '工程实践',
  study: '学习笔记'
}
const category = (post: (typeof posts)[number]): Exclude<Tab, 'all'> =>
  post.data.publishDate < STUDY_BEFORE
    ? 'study'
    : post.data.tags.some((t) => AI_TAGS.includes(t))
      ? 'ai'
      : 'eng'

// 文章里第一张本地配图（![](./x.webp)），有就放进动态里
const contentImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/**/*.{png,jpg,jpeg,webp}'
)
function firstImage(post: (typeof posts)[number]) {
  const m = post.body?.match(/!\[[^\]]*\]\(\.?\/?([^)\s]+\.(?:png|jpe?g|webp))\)/)
  if (!m || !post.filePath) return undefined
  const dir = post.filePath.slice(0, post.filePath.lastIndexOf('/'))
  return contentImages[`/${dir}/${m[1]}`]
}

const pad = (n: number) => String(n).padStart(2, '0')
// 日期按 UTC 取（frontmatter 里没写时区的时间按 UTC 存），今年的只写月.日
const shortDate = (d: Date) =>
  d.getUTCFullYear() === new Date().getUTCFullYear()
    ? `${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`
    : `${d.getUTCFullYear()}.${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`

const items = await Promise.all(
  posts.map(async (post) => {
    const img = firstImage(post)
    return {
      post,
      cat: category(post),
      date: shortDate(post.data.updatedDate ?? post.data.publishDate),
      minutes: (await render(post)).remarkPluginFrontmatter.minutesRead as string,
      by: authorshipLabel(post.data.authorship),
      image: img ? (await img()).default : undefined
    }
  })
)
const TABS: { key: Tab; label: string }[] = [
  { key: 'all', label: '全部' },
  { key: 'ai', label: 'AI 协作' },
  { key: 'eng', label: '工程实践' },
  { key: 'study', label: '学习笔记' }
]
const count = (key: Tab) =>
  key === 'all' ? items.length : items.filter((i) => i.cat === key).length

// 右栏
const WRITING_WEEKS = 20
const writing = writingDays(
  posts.map((p) => p.data.publishDate),
  WRITING_WEEKS
)
const writingTotal = writing.reduce((n, d) => n + d.count, 0)
const githubWeeks = 20
const githubDays = home.github.contributions
const githubTotal = githubDays.slice(-githubWeeks * 7).reduce((n, d) => n + d.count, 0)
const works = home.works.slice(0, 4)
const compact = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : `${(n / 1e6).toFixed(1)}M`)

const logo = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)[config.logo.src]
if (!logo) throw new Error(`"${config.logo.src}" 不在 src/assets/ 里`)
const avatar = (await logo()).default
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead title='Home' description={config.description} />
    <meta name='robots' content='noindex' />
    <ThemeProvider />
  </head>
  <body class='home-page'>
    <div class='page'>
      <header class='bar'>
        <a class='mark' href='/'>LZWcc</a>
        <nav>
          <a href='/blog'>文章</a>
          <a href='/archives'>归档</a>
          <a href='/links'>友链</a>
          <a href='/about'>关于</a>
          <a href={LAB}>作品站</a>
          <a href='/search' title='搜索'><Icon name='search' class='size-4' /></a>
          <button type='button' id='theme' title='切换深浅色'
            ><Icon name='sun' class='size-4 sun' /><Icon name='moon' class='size-4 moon' /></button
          >
        </nav>
      </header>

      <div class='layout'>
        <!-- ── 左：个人资料 ── -->
        <aside class='profile'>
          <div class='banner'><Image src={banner} alt='' loading='eager' /></div>
          <Image class='face' src={avatar} alt='LZWcc 的头像' width={152} loading='eager' />
          <h1>LZWcc</h1>
          <p class='handle'>软件工程 · 湖南工程学院</p>
          <p class='status'><i></i>正在找前端开发的工作</p>
          <p class='bio'>
            你好，我叫 LZWcc，是一个软件工程专业的本科生。这里记开发过程和学习笔记，做出来的东西放在<a
              href={LAB}>作品站</a
            >。
          </p>
          <nav class='links'>
            <a href='https://github.com/LZWcc' target='_blank' rel='noopener'
              ><Icon name='github' />GitHub</a
            >
            <a href={LAB}><Icon name='link' />作品站</a>
            <a href='/rss.xml'><Icon name='rss' />RSS</a>
          </nav>
          <dl class='numbers'>
            <div><dd>{posts.length}</dd><dt>文章</dt></div>
            <div><dd>{tags.length}</dd><dt>标签</dt></div>
            <div><dd>{home.works.length}</dd><dt>作品</dt></div>
            <div><dd>{compact(home.tokens.total)}</dd><dt>AI tokens</dt></div>
          </dl>
        </aside>

        <!-- ── 中：文章 ── -->
        <main class='feed'>
          <div class='tabs' role='tablist'>
            {
              TABS.map((t, i) => (
                <button
                  type='button'
                  role='tab'
                  data-tab={t.key}
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  {t.label}
                  <span>{count(t.key)}</span>
                </button>
              ))
            }
          </div>

          <article class='post pinned'>
            <Image class='who' src={avatar} alt='' width={72} />
            <div class='main'>
              <p class='meta'><b>LZWcc</b><span class='pin'>置顶</span></p>
              <details>
                <summary>
                  <span class='text'
                    >你好，我叫 LZWcc，是一个软件工程专业的本科生。<del>目前正在学习前端开发。</del
                    ></span
                  >
                  <span class='more'>展开</span>
                </summary>
                <p>
                  每天都用 AI 写代码完成作业做 PPT，用 AI 写代码，用 AI 优化 AI 写的代码， 用 AI 给
                  AI 优化过的代码继续加注释、补报告、编思路，同时威胁 AI 写出来的代码不要像 AI
                  写的代码。换一个 AI 去检查我用 AI 写的代码是不是太像 AI 写的，结果显示 AI
                  味太重了，于是我用 AI 降低 AI 写的这份代码的 AI 味，最后再拿 AI 来检测。
                </p>
                <p>
                  我用 AI 降完后的 AI 味很低，终于可以提交 AI 作业了。然后平台用 AI 审核我用 AI
                  写的作业，给我一堆 AI 的修改建议，然后我用 AI 根据它的 AI 建议，继续用 AI 修改我用
                  AI 写的代码。
                </p>
                <p>
                  最后让 AI 拿着 AI 写的反馈和我用 AI 修改后的 AI 作业，用 AI
                  写一份实验报告和提交说明。最后 AI 练习并强化了软件工程能力。
                </p>
                <p>
                  学期结束，AI
                  熟练掌握了我的专业课内容、代码风格和答辩话术。而我，熟练掌握了复制、粘贴、追问和假装自己懂了。
                </p>
                <a class='about' href='/about'>更多关于我 →</a>
              </details>
            </div>
          </article>

          <div class='posts'>
            {
              items.map(({ post, cat, date, minutes, by, image }) => (
                <article class='post' data-cat={cat}>
                  <Image class='who' src={avatar} alt='' width={72} />
                  <div class='main'>
                    <p class='meta'>
                      <b>LZWcc</b>
                      <span>·</span>
                      <time
                        datetime={(post.data.updatedDate ?? post.data.publishDate).toISOString()}
                      >
                        {date}
                      </time>
                      <span class='kind'>{TAB_NAME[cat]}</span>
                    </p>
                    <a class='body' href={`/blog/${post.id}/`} data-astro-prefetch>
                      <h2>{post.data.title}</h2>
                      <p class='text'>{post.data.description}</p>
                      {image && (
                        <span class='media'>
                          <Image src={image} alt='' width={720} loading='lazy' />
                        </span>
                      )}
                    </a>
                    <p class='foot'>
                      <span>{minutes}</span>
                      {post.data.tags.slice(0, 4).map((t) => (
                        <a href={`/tags/${t}`}>#{t}</a>
                      ))}
                      {by && <span class='by'>{by}</span>}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
          <p class='end'><a href='/archives'>到底了。按年份看全部文章 →</a></p>
        </main>

        <!-- ── 右栏 ── -->
        <aside class='rail'>
          <section>
            <h2>写作记录</h2>
            <p class='sum'><b>{writingTotal}</b> 篇 · 最近 {WRITING_WEEKS} 周</p>
            <Heatmap days={writing} weeks={WRITING_WEEKS} unit='篇' />
          </section>
          <section>
            <h2>作品站</h2>
            <ul class='works'>
              {
                works.map((w) => (
                  <li>
                    <a href={`${LAB}${w.path}`}>
                      {w.cover && (
                        <img
                          src={`${LAB}${w.cover}`}
                          alt=''
                          width='72'
                          height='45'
                          loading='lazy'
                        />
                      )}
                      <span>
                        <small>No.{w.no}</small>
                        {w.short ?? w.title}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class='all' href={`${LAB}/works`}>全部 {home.works.length} 件作品 →</a>
          </section>
          <section>
            <h2>常用的工具</h2>
            <TechStack stack={home.stack} />
          </section>
          <section>
            <h2>AI 用量</h2>
            <TokenUsage tokens={home.tokens} />
          </section>
          <section>
            <h2>GitHub</h2>
            <p class='sum'><b>{githubTotal.toLocaleString()}</b> 次贡献 · 最近 {githubWeeks} 周</p>
            <Heatmap days={githubDays} weeks={githubWeeks} unit='次贡献' />
            <a
              class='all'
              href={`https://github.com/${home.github.user}`}
              target='_blank'
              rel='noopener'>去 GitHub 看看 ↗</a
            >
          </section>
        </aside>
      </div>
    </div>
    <div class='foot-wrap'><Footer /></div>

    <script>
      // 深浅色切换：和主题的 setTheme 做的一样（存 localStorage.theme、切 .dark、改 theme-color），其他页面读得到。
      // 不直接 import astro-pure/utils：它连带引入的 date.ts 依赖 virtual:config，浏览器端打包会失败
      document.getElementById('theme')!.addEventListener('click', () => {
        const dark = !document.documentElement.classList.contains('dark')
        localStorage.setItem('theme', dark ? 'dark' : 'light')
        document.documentElement.classList.toggle('dark', dark)
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#0B0B10' : '#FCFCFD')
      })
      // 中间一栏按类别筛选：没有 JS 时显示全部
      const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs button')
      const rows = document.querySelectorAll<HTMLElement>('.posts .post')
      tabs.forEach((tab) =>
        tab.addEventListener('click', () => {
          const key = tab.dataset.tab!
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)))
          rows.forEach((row) => (row.hidden = key !== 'all' && row.dataset.cat !== key))
        })
      )
    </script>
  </body>
</html>

<style is:global>
  /* 作品站的配色（ui-motion-lab 的 app/assets/css/home.css），只用在这一页 */
  .home-page {
    --h-bg: #f6f6f6;
    --h-card: #fdfdfc;
    --h-surface-glass: rgb(255 255 255 / 82%);
    --h-line: rgb(0 0 0 / 8%);
    --h-ink: #1d1d1d;
    --h-ink-2: #3a3a3a;
    --h-ink-3: #5a5a5a;
    --h-muted: #8a8a8a;
    --h-faint: #a8a8a8;
    --h-empty: #e4e4e4;
    --h-accent: #2f5bff;
    --h-accent-rgb: 47 91 255;
    --h-heat-1: #c7d3ff;
    --h-heat-2: #8fa7ff;
    --h-heat-3: #5779ff;
    --h-heat-4: #2f5bff;
    --h-plate-top: #ffffff;
    --h-plate-bottom: #f2f2f2;
    --h-plate-hi: #ffffff;
    --h-plate-e1: #e9e9e9;
    --h-plate-e2: #e5e5e5;
    --h-plate-e3: #e1e1e1;
    --h-plate-e4: #dcdcdc;
    --h-plate-shadow: rgb(0 0 0 / 9%);
    --h-engrave: #f0f0f0;
    --h-engrave-ink: #9a9a9a;
    background: var(--h-bg);
    color: var(--h-ink);
    font-family: 'PingFang SC', system-ui, sans-serif;
  }
  .dark .home-page {
    --h-bg: #0e0e0f;
    --h-card: #161618;
    --h-surface-glass: rgb(30 30 33 / 82%);
    --h-line: rgb(255 255 255 / 9%);
    --h-ink: #ededed;
    --h-ink-2: #cfcfd2;
    --h-ink-3: #a3a3a8;
    --h-muted: #8b8b90;
    --h-faint: #5e5e63;
    --h-empty: #232326;
    --h-accent: #6f8dff;
    --h-accent-rgb: 111 141 255;
    --h-heat-1: #1d2852;
    --h-heat-2: #2c3f99;
    --h-heat-3: #4466f0;
    --h-heat-4: #8aa2ff;
    --h-plate-top: #2e2e32;
    --h-plate-bottom: #232326;
    --h-plate-hi: rgb(255 255 255 / 10%);
    --h-plate-e1: #1d1d20;
    --h-plate-e2: #1a1a1d;
    --h-plate-e3: #17171a;
    --h-plate-e4: #141416;
    --h-plate-shadow: rgb(0 0 0 / 45%);
    --h-engrave: #1f1f22;
    --h-engrave-ink: #6e6e74;
  }
</style>

<style>
  .page {
    --mono: 'SF Mono', ui-monospace, Menlo, monospace;
    --w: 1240px;
    min-height: 100vh;
    padding: 0 32px 64px;
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--w);
    height: 60px;
    margin: 0 auto;
    border-bottom: 1px solid var(--h-line);
    background: var(--h-bg);
    font-size: 13px;
  }
  .mark {
    font-family: var(--mono);
    font-weight: 600;
  }
  .bar nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--h-muted);
  }
  .bar nav a:hover,
  .bar button:hover {
    color: var(--h-ink);
  }
  .bar button {
    display: grid;
    color: var(--h-muted);
  }
  .bar .moon,
  :global(.dark) .bar .sun {
    display: none;
  }
  :global(.dark) .bar .moon {
    display: block;
  }
  .layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 330px;
    align-items: start;
    gap: 40px;
    max-width: var(--w);
    margin: 0 auto;
  }

  /* ── 左：个人资料 ── */
  .profile {
    position: sticky;
    top: 84px;
    padding-top: 24px;
  }
  .banner {
    height: 92px;
    overflow: hidden;
    border-radius: 8px;
  }
  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .face {
    position: relative;
    width: 76px;
    height: 76px;
    margin: -38px 0 0 14px;
    border: 3px solid var(--h-bg);
    border-radius: 50%;
    background: var(--h-card);
    object-fit: cover;
  }
  .profile h1 {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 600;
  }
  .handle {
    color: var(--h-muted);
    font-size: 13px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    padding: 3px 10px 3px 8px;
    border: 1px solid rgb(var(--h-accent-rgb) / 20%);
    border-radius: 999px;
    background: rgb(var(--h-accent-rgb) / 7%);
    color: var(--h-accent);
    font-size: 11.5px;
  }
  .status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--h-accent);
  }
  .bio {
    margin-top: 14px;
    color: var(--h-ink-3);
    font-size: 13px;
    line-height: 1.8;
  }
  .bio a {
    color: var(--h-accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 14px;
    font-size: 12.5px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--h-ink-2);
  }
  .links a:hover {
    color: var(--h-accent);
  }
  .numbers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--h-line);
  }
  .numbers dd {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 600;
  }
  .numbers dt {
    color: var(--h-muted);
    font-size: 11px;
  }

  /* ── 中：文章 ── */
  .feed {
    min-height: 100vh;
    border-inline: 1px solid var(--h-line);
  }
  .tabs {
    position: sticky;
    top: 60px;
    z-index: 10;
    display: flex;
    border-bottom: 1px solid var(--h-line);
    background: var(--h-bg);
  }
  .tabs button {
    position: relative;
    flex: 1;
    height: 46px;
    color: var(--h-muted);
    font-size: 13px;
  }
  .tabs button span {
    margin-left: 5px;
    font-family: var(--mono);
    font-size: 10.5px;
  }
  .tabs button[aria-selected='true'] {
    color: var(--h-ink);
    font-weight: 600;
  }
  .tabs button[aria-selected='true']::after {
    position: absolute;
    bottom: -1px;
    left: 50%;
    width: 36px;
    height: 2px;
    margin-left: -18px;
    border-radius: 1px;
    background: var(--h-accent);
    content: '';
  }
  .post {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--h-line);
  }
  .who {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--h-card);
    object-fit: cover;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--h-muted);
    font-size: 12.5px;
  }
  .meta b {
    color: var(--h-ink);
    font-family: var(--mono);
    font-weight: 600;
  }
  .meta time {
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .pin,
  .kind {
    padding: 0 6px;
    border: 1px solid var(--h-line);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 18px;
  }
  .kind {
    margin-left: auto;
  }
  .body {
    display: block;
  }
  .body h2 {
    margin-top: 4px;
    color: var(--h-ink);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
  }
  .body:hover h2 {
    color: var(--h-accent);
  }
  .text {
    margin-top: 2px;
    color: var(--h-ink-2);
