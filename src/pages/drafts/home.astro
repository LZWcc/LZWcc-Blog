---
// 首页草稿（homepage-feed 分支）：照 ui-motion-lab 标签 homepage-feed-v1 的信息流三栏版。
//   左边个人资料（颗粒渐变横幅），中间每篇文章是一条动态（置顶一段自我介绍，可以按类别筛选），
//   右边写作记录、作品站最新作品、常用的工具、AI 用量、GitHub。
// 配色用作品站的 --h-* 变量（只在这一页）；顶栏和页脚用博客主题的，主题的颜色变量在这一页换成作品站的配色。
// 作品站的数据来自 lab.lzwcc.xyz/home.json（src/utils/home-data.ts）。定下来以后替换 src/pages/index.astro。
import { Image } from 'astro:assets'
import { render } from 'astro:content'

import { Quote } from 'astro-pure/advanced'
import { Footer, Header, ThemeProvider } from 'astro-pure/components/basic'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Card, Icon } from 'astro-pure/user'
import BaseHead from '@/components/BaseHead.astro'
import Heatmap from '@/components/feed/Heatmap.astro'
import TechStack from '@/components/feed/TechStack.astro'
import TokenUsage from '@/components/feed/TokenUsage.astro'
import { authorshipLabel } from '@/utils/authorship'
import { CATEGORIES, categoryLabel, type Category } from '@/utils/category'
import { writingDays } from '@/utils/heatmap'
import { getHomeData, LAB } from '@/utils/home-data'
import banner from '@/assets/home/banner.webp'
import config from '@/site-config'

import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

const posts = sortMDByDate(await getBlogCollection())
const tags = getUniqueTagsWithCount(posts)
const home = await getHomeData()

// 中间一栏按 frontmatter 的 category 分栏（一篇一类，见 src/utils/category.ts）；没填的只在「全部」里
type Tab = 'all' | Category

// 文章里的本地配图（![](./x.webp)），按出现顺序。博客的图多是截图和示意图，裁掉就看不懂，所以都不裁：
//   全是宽图（宽 ≥ 高 × 1.8，如 Lighthouse、终端截图）：上下叠放、按原比例，最多 2 张
//   其他：照推特的格子排（1 整宽 / 2 并排 / 3 一大两小 / 4 田字），每张完整缩放进格子
// 放不下的在最后一张上标 +N
const contentImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/**/*.{png,jpg,jpeg,webp}'
)
const MAX_IMAGES = 4
const MAX_STACKED = 2
const WIDE = 1.8
function localImages(post: (typeof posts)[number]) {
  if (!post.body || !post.filePath) return []
  const dir = post.filePath.slice(0, post.filePath.lastIndexOf('/'))
  const files = [...post.body.matchAll(/!\[[^\]]*\]\(\.?\/?([^)\s]+\.(?:png|jpe?g|webp))\)/g)].map(
    (m) => m[1]
  )
  return [...new Set(files)].map((f) => contentImages[`/${dir}/${f}`]).filter((load) => !!load)
}

const pad = (n: number) => String(n).padStart(2, '0')
// 日期按 UTC 取（frontmatter 里没写时区的时间按 UTC 存），今年的只写月.日
const shortDate = (d: Date) =>
  d.getUTCFullYear() === new Date().getUTCFullYear()
    ? `${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`
    : `${d.getUTCFullYear()}.${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`

async function mediaLayout(loads: ReturnType<typeof localImages>) {
  const all = await Promise.all(
    loads.slice(0, MAX_IMAGES).map(async (load) => (await load()).default)
  )
  const stacked = all.length > 1 && all.every((img) => img.width / img.height >= WIDE)
  const images = stacked ? all.slice(0, MAX_STACKED) : all
  return { images, stacked, moreImages: loads.length - images.length }
}

const items = await Promise.all(
  posts.map(async (post) => {
    const loads = localImages(post)
    return {
      post,
      cat: post.data.category,
      date: shortDate(post.data.updatedDate ?? post.data.publishDate),
      minutes: (await render(post)).remarkPluginFrontmatter.minutesRead as string,
      by: authorshipLabel(post.data.authorship),
      ...(await mediaLayout(loads))
    }
  })
)
const TABS: { key: Tab; label: string; note?: string }[] = [
  { key: 'all', label: '全部' },
  ...CATEGORIES.map((c) => ({ key: c.key, label: c.label, note: c.note }))
]
const count = (key: Tab) =>
  key === 'all' ? items.length : items.filter((i) => i.cat === key).length

// 左栏的技能：原首页的 Skills，按作品站技术栈卡片（ui-motion-lab 的 app/data/stack.ts）、项目文章的 stack
// 和博客文章的标签补全（2026-10）。MaintPilot 的后端（PostgreSQL、pgvector）是同学做的，不算在内
const SKILLS: [string, string[]][] = [
  ['语言', ['TypeScript', 'JavaScript', 'HTML / CSS', 'Python', 'Go', 'Java', 'C++', 'Assembly']],
  ['前端', ['Vue', 'React', 'Nuxt', 'Astro', 'Tailwind CSS', 'Sass', 'Pinia', 'Vite', 'WXT']],
  ['后端', ['Node.js', 'Fastify', 'MySQL', 'SQLite', 'Supabase', 'Nginx', 'Docker', 'Vercel']],
  ['工具', ['Git', 'GitHub Actions', 'pnpm', 'Vitest', 'Linux', 'Claude Code', 'Codex']]
]

// 右栏
const WRITING_WEEKS = 20
const writing = writingDays(
  posts.map((p) => p.data.publishDate),
  WRITING_WEEKS
)
const writingTotal = writing.reduce((n, d) => n + d.count, 0)
const githubWeeks = 20
const githubDays = home.github.contributions
const githubTotal = githubDays.slice(-githubWeeks * 7).reduce((n, d) => n + d.count, 0)
const works = home.works.slice(0, 4)
const compact = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : `${(n / 1e6).toFixed(1)}M`)

const logo = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)[config.logo.src]
if (!logo) throw new Error(`"${config.logo.src}" 不在 src/assets/ 里`)
const avatar = (await logo()).default
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead title='Home' description={config.description} />
    <meta name='robots' content='noindex' />
    <ThemeProvider />
    <script is:inline>
      if (new URLSearchParams(location.search).get('palette') === 'lab')
        document.documentElement.classList.add('palette-lab')
    </script>
  </head>
  <body class='home-page'>
    <div class='glow' aria-hidden='true'></div>
    <div class='page'>
      <div class='inner'>
        <Header />

        <div class='layout'>
          <!-- ── 左：个人资料 ── -->
          <aside class='profile'>
            <div class='banner'><Image src={banner} alt='' loading='eager' /></div>
            <Image class='face' src={avatar} alt='LZWcc 的头像' width={152} loading='eager' />
            <h1>LZWcc</h1>
            <p class='handle'>软件工程 · 湖南工程学院</p>
            <p class='status'><i></i>正在找前端开发的工作</p>
            <p class='bio'>
              你好，我叫
              LZWcc，是一个软件工程专业的本科生。这里记开发过程和学习笔记，做出来的东西放在<a
                href={LAB}>作品站</a
              >。
            </p>
            <nav class='links'>
              <a href='https://github.com/LZWcc' target='_blank' rel='noopener'
                ><Icon name='github' />GitHub</a
              >
              <a href={LAB}><Icon name='link' />作品站</a>
              <a href='/rss.xml'><Icon name='rss' />RSS</a>
            </nav>
            <dl class='numbers'>
              <div><dd>{posts.length}</dd><dt>文章</dt></div>
              <div><dd>{tags.length}</dd><dt>标签</dt></div>
              <div><dd>{home.works.length}</dd><dt>作品</dt></div>
              <div><dd>{compact(home.tokens.total)}</dd><dt>AI tokens</dt></div>
            </dl>
            <h2 class='side-h'>教育</h2>
            <Card
              as='a'
              class='edu'
              heading='湖南工程学院'
              subheading='软件工程'
              date='2024.09 – 至今'
              href='https://www.hnie.edu.cn/'
            >
              <img
                class='absolute end-0 z-0 m-0 -my-3 h-full w-1/2 object-cover opacity-40'
                src='/images/HNIE.svg'
                alt=''
                aria-hidden='true'
              />
            </Card>
            <h2 class='side-h'>技能</h2>
            <dl class='skills'>
              {
                SKILLS.map(([k, list]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>
                      {list.map((x) => (
                        <span>{x}</span>
                      ))}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </aside>

          <!-- ── 中：文章 ── -->
          <main class='feed'>
            <div class='tabs' role='tablist'>
              {
                TABS.map((t, i) => (
                  <button
                    type='button'
                    role='tab'
                    data-tab={t.key}
                    title={t.note}
                    aria-selected={i === 0 ? 'true' : 'false'}
                  >
                    {t.label}
                    <span>{count(t.key)}</span>
                  </button>
                ))
              }
            </div>

            <article class='post pinned'>
              <Image class='who' src={avatar} alt='' width={72} />
              <div class='main'>
                <p class='meta'><b>LZWcc</b><span class='pin'>置顶</span></p>
                <details>
                  <summary>
                    <span class='text'
                      >你好，我叫 LZWcc，是一个软件工程专业的本科生。<del
                        >目前正在学习前端开发。</del
                      ></span
                    >
                    <span class='more'>展开</span>
                  </summary>
                  <p>
                    每天都用 AI 写代码完成作业做 PPT，用 AI 写代码，用 AI 优化 AI 写的代码， 用 AI
                    给 AI 优化过的代码继续加注释、补报告、编思路，同时威胁 AI 写出来的代码不要像 AI
                    写的代码。换一个 AI 去检查我用 AI 写的代码是不是太像 AI 写的，结果显示 AI
                    味太重了，于是我用 AI 降低 AI 写的这份代码的 AI 味，最后再拿 AI 来检测。
                  </p>
                  <p>
                    我用 AI 降完后的 AI 味很低，终于可以提交 AI 作业了。然后平台用 AI 审核我用 AI
                    写的作业，给我一堆 AI 的修改建议，然后我用 AI 根据它的 AI 建议，继续用 AI
                    修改我用 AI 写的代码。
                  </p>
                  <p>
                    最后让 AI 拿着 AI 写的反馈和我用 AI 修改后的 AI 作业，用 AI
                    写一份实验报告和提交说明。最后 AI 练习并强化了软件工程能力。
                  </p>
                  <p>
                    学期结束，AI
                    熟练掌握了我的专业课内容、代码风格和答辩话术。而我，熟练掌握了复制、粘贴、追问和假装自己懂了。
                  </p>
                  <a class='about' href='/about'>更多关于我 →</a>
                </details>
              </div>
            </article>

            <div class='posts'>
              {
                items.map(({ post, cat, date, minutes, by, images, stacked, moreImages }) => (
                  <article class='post' data-cat={cat ?? ''}>
                    <Image class='who' src={avatar} alt='' width={72} />
                    <div class='main'>
                      <p class='meta'>
                        <b>LZWcc</b>
                        <span>·</span>
                        <time
                          datetime={(post.data.updatedDate ?? post.data.publishDate).toISOString()}
                        >
                          {date}
                        </time>
                        {cat && <span class='kind'>{categoryLabel(cat)}</span>}
                      </p>
                      <a class='body' href={`/blog/${post.id}/`} data-astro-prefetch>
                        <h2>{post.data.title}</h2>
                        <p class='text'>{post.data.description}</p>
                        {images.length > 0 && (
                          <span class={`media ${stacked ? 'stack' : `n${images.length}`}`}>
                            {images.map((img, i) => (
                              <span
                                class='cell'
                                data-more={
                                  i === images.length - 1 && moreImages
                                    ? `+${moreImages}`
                                    : undefined
                                }
                              >
                                <Image
                                  src={img}
                                  alt=''
                                  width={images.length === 1 || stacked ? 720 : 480}
                                  loading='lazy'
                                />
                              </span>
                            ))}
                          </span>
                        )}
                      </a>
                      <p class='foot'>
                        <span>{minutes}</span>
                        {post.data.tags.slice(0, 4).map((t) => (
                          <a href={`/tags/${t}`}>#{t}</a>
                        ))}
                        {by && <span class='by'>{by}</span>}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
            <div class='end'>
              <Quote />
              <p><a href='/archives'>到底了。按年份看全部文章 →</a></p>
            </div>
          </main>

          <!-- ── 右栏 ── -->
          <aside class='rail'>
            <section>
              <h2>写作记录</h2>
              <p class='sum'><b>{writingTotal}</b> 篇 · 最近 {WRITING_WEEKS} 周</p>
              <Heatmap days={writing} weeks={WRITING_WEEKS} unit='篇' />
            </section>
            <section>
              <h2>作品站</h2>
              <ul class='works'>
                {
                  works.map((w) => (
                    <li>
                      <a href={`${LAB}${w.path}`}>
                        {w.cover && (
                          <img
                            src={`${LAB}${w.cover}`}
                            alt=''
                            width='72'
                            height='45'
                            loading='lazy'
                          />
                        )}
                        <span>
                          <small>No.{w.no}</small>
                          {w.short ?? w.title}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a class='all' href={`${LAB}/works`}>全部 {home.works.length} 件作品 →</a>
            </section>
            <section>
              <h2>常用的工具</h2>
              <TechStack stack={home.stack} />
            </section>
            <section>
              <h2>AI 用量</h2>
              <TokenUsage tokens={home.tokens} />
            </section>
            <section>
              <h2>GitHub</h2>
              <p class='sum'>
                <b>{githubTotal.toLocaleString()}</b> 次贡献 · 最近 {githubWeeks} 周
              </p>
              <Heatmap days={githubDays} weeks={githubWeeks} unit='次贡献' />
              <a
                class='all'
                href={`https://github.com/${home.github.user}`}
                target='_blank'
                rel='noopener'>去 GitHub 看看 ↗</a
              >
            </section>
          </aside>
        </div>
      </div>
    </div>
    <div class='foot-wrap'><Footer /></div>

    <script>
      // 中间一栏按类别筛选（没有 JS 时显示全部）。选中的类别写进地址 ?cat=，刷新、分享链接都还在这一类；
      // 置顶的自我介绍只在「全部」里显示
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')]
      const rows = document.querySelectorAll<HTMLElement>('.posts .post')
      const pinned = document.querySelector<HTMLElement>('.pinned')!
      const feed = document.querySelector<HTMLElement>('.feed')!
      function show(key: string, scroll: boolean) {
        if (!tabs.some((t) => t.dataset.tab === key)) key = 'all'
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === key)))
        rows.forEach((row) => (row.hidden = key !== 'all' && row.dataset.cat !== key))
        pinned.hidden = key !== 'all'
        const url = new URL(location.href)
        if (key === 'all') url.searchParams.delete('cat')
        else url.searchParams.set('cat', key)
        history.replaceState(null, '', url)
        // 已经往下滚过的话，回到列表顶部（分类栏下面），不停在不相关的中间位置
        if (scroll && feed.getBoundingClientRect().top < 0)
          feed.scrollIntoView({ behavior: 'smooth' })
      }
      tabs.forEach((tab) => tab.addEventListener('click', () => show(tab.dataset.tab!, true)))
      // 分类栏吸顶时加 .stuck（只在滚动时检查，一帧最多一次）
      const bar = document.querySelector<HTMLElement>('.tabs')!
      let ticking = false
      const checkStuck = () => {
        ticking = false
        const top = parseFloat(getComputedStyle(bar).top)
        bar.classList.toggle('stuck', bar.getBoundingClientRect().top <= top + 0.5 && scrollY > 0)
      }
      addEventListener(
        'scroll',
        () => {
          if (!ticking) ((ticking = true), requestAnimationFrame(checkStuck))
        },
        { passive: true }
      )
      checkStuck()
      show(new URLSearchParams(location.search).get('cat') ?? 'all', false)
      // 左右两栏学推特：比屏幕矮就停在顶栏下面；比屏幕高就先跟着页面滚，底部露出来以后停住。
      // 停的位置在样式里算（.profile, .rail 的 top），这里只把栏的高度交给它
      const asides = document.querySelectorAll<HTMLElement>('.profile, .rail')
      const measure = () =>
        asides.forEach((el) => el.style.setProperty('--h', `${el.offsetHeight}px`))
      const resize = new ResizeObserver(measure)
      asides.forEach((el) => resize.observe(el))
    </script>
  </body>
</html>

<style is:global>
  /* 作品站的配色（ui-motion-lab 的 app/assets/css/home.css），只用在这一页 */
  .home-page {
    --h-bg: #f6f6f6;
    --h-card: #fdfdfc;
    --h-surface-glass: rgb(255 255 255 / 82%);
    --h-line: rgb(0 0 0 / 8%);
    --h-ink: #1d1d1d;
    --h-ink-2: #3a3a3a;
    --h-ink-3: #5a5a5a;
    --h-muted: #8a8a8a;
    --h-faint: #a8a8a8;
    --h-empty: rgb(0 0 0 / 7%); /* 半透明：底色带了淡蓝渐变，实色的浅灰会看不见 */
    /* 强调色和热力图用旧博客的青蓝（主题 --primary: 200 29% 45%，顶部渐变 #659EB9） */
    --h-accent: #518197;
    --h-accent-rgb: 81 129 151;
    --h-heat-1: #cfe3ec;
    --h-heat-2: #9cc4d6;
    --h-heat-3: #659eb9;
    --h-heat-4: #3f7590;
    --h-plate-top: #ffffff;
    --h-plate-bottom: #f2f2f2;
    --h-plate-hi: #ffffff;
    --h-plate-e1: #e9e9e9;
    --h-plate-e2: #e5e5e5;
    --h-plate-e3: #e1e1e1;
    --h-plate-e4: #dcdcdc;
    --h-plate-shadow: rgb(0 0 0 / 9%);
    --h-engrave: #f0f0f0;
    --h-engrave-ink: #9a9a9a;
    /* 博客主题的颜色变量换成作品站的配色：主题的顶栏、页脚跟着变 */
    --background: 0 0% 96.5%;
    --foreground: 0 0% 11.4%;
    --muted: 0 0% 93%;
    --muted-foreground: 0 0% 35%;
    --border: 0 0% 89%;
    --primary: 200 29% 45%;
    background: var(--h-bg);
    color: var(--h-ink);
    font-family: 'PingFang SC', system-ui, sans-serif;
  }
  .dark .home-page {
    --h-bg: #0e0e0f;
    --h-card: #161618;
    --h-surface-glass: rgb(30 30 33 / 82%);
    --h-line: rgb(255 255 255 / 9%);
    --h-ink: #ededed;
    --h-ink-2: #cfcfd2;
    --h-ink-3: #a3a3a8;
    --h-muted: #8b8b90;
    --h-faint: #5e5e63;
    --h-empty: #232326;
    --h-accent: #8fd3ec;
    --h-accent-rgb: 143 211 236;
    --h-heat-1: #16303b;
    --h-heat-2: #23566b;
    --h-heat-3: #3a87a6;
    --h-heat-4: #7cc6e3;
    --h-plate-top: #2e2e32;
    --h-plate-bottom: #232326;
    --h-plate-hi: rgb(255 255 255 / 10%);
    --h-plate-e1: #1d1d20;
    --h-plate-e2: #1a1a1d;
    --h-plate-e3: #17171a;
    --h-plate-e4: #141416;
    --h-plate-shadow: rgb(0 0 0 / 45%);
    --h-engrave: #1f1f22;
    --h-engrave-ink: #6e6e74;
    --background: 240 3% 5.7%;
    --foreground: 0 0% 93%;
    --muted: 240 4% 10%;
    --muted-foreground: 240 2.5% 65%;
    --border: 240 3% 17%;
    --primary: 195 95% 85%;
  }
  /* ?palette=lab：作品站原来的亮蓝，方便和融合版对比（草稿阶段用） */
  .palette-lab .home-page {
    --h-empty: #e4e4e4;
    --h-accent: #2f5bff;
    --h-accent-rgb: 47 91 255;
    --h-heat-1: #c7d3ff;
    --h-heat-2: #8fa7ff;
    --h-heat-3: #5779ff;
    --h-heat-4: #2f5bff;
    --primary: 227 100% 59%;
  }
  .dark.palette-lab .home-page {
    --h-accent: #6f8dff;
    --h-accent-rgb: 111 141 255;
    --h-heat-1: #1d2852;
    --h-heat-2: #2c3f99;
    --h-heat-3: #4466f0;
    --h-heat-4: #8aa2ff;
    --primary: 227 100% 72%;
  }
  /* 顶部那层淡蓝渐变，和博客其他页面（BaseLayout 的 highlightColor）一样 */
  .home-page .glow {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    height: 100vh;
    background-image: linear-gradient(#659eb9, transparent);
    opacity: 0.25;
    pointer-events: none;
  }
  .palette-lab .home-page .glow {
    display: none;
  }
  .home-page .page {
    position: relative;
  }
  /* 主题顶栏往下滚会藏起来（data-show=false），藏起来时下面吸顶的东西往上收 */
